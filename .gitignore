#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Log files
*.tlog

# db files
*.db*

#Visual studio specific files
*.ipch
*.vsidx
*.suo
*.obj
*.ilk
*.pdb
*.pdb
.vs/
obj/
ffmpegPlayer.dir/
Debug/
Release/
*.recipe
/winplayer/ffmpegDlls/bin-video/ffmpegPlayer.exp
/winplayer/ffmpegDlls/bin-video/avcodec-58.dll
